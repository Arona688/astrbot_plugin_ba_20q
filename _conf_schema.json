{
  "api_key": {
    "description": "DeepSeek API Key（留空则使用 AstrBot 当前对话模型）",
    "type": "string",
    "default": "",
    "hint": "填入 sk- 开头的 key 后，游戏直连 DeepSeek 官方接口"
  },
  "api_base": {
    "description": "接口地址",
    "type": "string",
    "default": "https://api.deepseek.com/v1"
  },
  "model": {
    "description": "模型名",
    "type": "string",
    "default": "deepseek-chat",
    "hint": "可填 deepseek-chat / deepseek-reasoner"
  },
  "max_questions": {
    "description": "每局最多提问数",
    "type": "int",
    "default": 12,
    "hint": "问满后强制给出答案，不允许继续提问"
  },
  "timeout": {
    "description": "单次调用超时（秒）",
    "type": "int",
    "default": 45
  }
}
